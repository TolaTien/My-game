# AI Proxy Server URL (khóa GEMINI_API_KEY chỉ đặt ở server/ai_proxy/.env, KHÔNG đặt trong app/APK)
# Ví dụ chạy local trên Chrome: http://localhost:8000 | Android Emulator: http://10.0.2.2:8000
# Để trống sẽ tự động chạy Chế độ Demo (FAQ & Keyword NLP Offline)
AI_PROXY_URL=

# Firebase Configuration (truyền qua --dart-define-from-file=.env khi build/run)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_APP_ID_WEB=your_firebase_web_app_id
FIREBASE_APP_ID_ANDROID=your_firebase_android_app_id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
