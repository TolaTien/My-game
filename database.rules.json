{
  "rules": {
    "usernames": {
      "$nameKey": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'displayName']) && newData.child('uid').val() == auth.uid && newData.child('displayName').isString() && newData.child('displayName').val().length >= 3 && newData.child('displayName').val().length <= 16"
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "directory": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "parties": {
      "$partyCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "solo_rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "invitations": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "invitation_responses": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "friend_requests": {
      "$toCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "friend_request_responses": {
      "$fromCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "friendships": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "leaderboard": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['uid', 'name', 'rankPoints']) && newData.child('uid').val() == $uid && newData.child('rankPoints').isNumber() && newData.child('rankPoints').val() >= 0"
      }
    },
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "account": {
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
          }
        },
        "profile": {
          "gold": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "xu": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "rankPoints": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "rankStars": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "playerName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
          }
        }
      }
    }
  }
}
